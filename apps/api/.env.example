# ── Server ──
NODE_ENV=development
PORT=4000
# Public URL of this API (used to build upload URLs and Stripe return links)
API_PUBLIC_URL=http://localhost:4000
# Public URL of the website (used in emails and Stripe onboarding return)
WEB_PUBLIC_URL=http://localhost:5173

# ── Database (MySQL 8) ──
DATABASE_URL="mysql://mybeauty:mybeauty@localhost:3306/mybeauty"

# ── Auth ── generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=change-me-access-secret-at-least-32-characters
JWT_REFRESH_SECRET=change-me-refresh-secret-at-least-32-characters
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_DAYS=30

# ── Stripe ── leave STRIPE_SECRET_KEY empty to use the built-in MOCK gateway (no real money, no network)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PUBLISHABLE_KEY=

# ── Files ── "local" stores in ./uploads; "s3" uses any S3-compatible bucket (Cloudflare R2, AWS S3)
STORAGE_DRIVER=local
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PUBLIC_URL=

# ── Email ── leave SMTP_HOST empty to print emails to the console
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM="MyBeauty+ <noreply@mybeauty.it>"

# ── Jobs ── set to false on extra API instances so cron jobs run only once
RUN_JOBS=true
